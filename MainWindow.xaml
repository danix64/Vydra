<Window x:Class="Vydra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vydra" Height="640" Width="900"
        MinHeight="580" MinWidth="760"
        Background="#1B2838"
        Icon="pack://application:,,,/vydra.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SteamButton" TargetType="Button">
            <Setter Property="Background" Value="#2A475E"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D6A8F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#22303F"/>
                                <Setter Property="Foreground" Value="#5A6B7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SteamButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#16202D"/>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A475E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SteamTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16202D"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="BorderBrush" Value="#2A475E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#C7D5E0"/>
        </Style>

        <Style x:Key="SteamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SteamCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#16202D"
                                                BorderBrush="#2A475E"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#8F98A0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#66C0F4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#C7D5E0"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#16202D"
                                            BorderBrush="#2A475E"
                                            BorderThickness="1"
                                            CornerRadius="0,0,3,3">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#C7D5E0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A475E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D6A8F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0E1621"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#0E1621">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2A475E" CornerRadius="5" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3D6A8F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0E1621">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#2A475E" CornerRadius="5" Margin="0,2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#3D6A8F"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1B2838"
            BorderBrush="#2A475E"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#16202D"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/vydra.ico"
                       Width="18" Height="18"
                       Margin="12,0,8,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Grid.Column="1"
                           Text="Vydra"
                           Foreground="#66C0F4"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="⚙"
                        Width="46" Height="36"
                        Background="Transparent"
                        Foreground="#C7D5E0"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        ToolTip="Настройки"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SettingsBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A475E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3"
                        Content="─"
                        Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeBtn_Click"/>

                <Button x:Name="MaximizeBtn" Grid.Column="4"
                        Content="☐"
                        Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeBtn_Click"/>

                <Button Grid.Column="5"
                        Content="✕"
                        Style="{StaticResource CloseCaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseBtn_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Ссылка на видео (YouTube)" Style="{StaticResource SteamLabel}"/>
                    <TextBox x:Name="UrlBox" Style="{StaticResource SteamTextBox}"
                             Text="https://www.youtube.com/watch?v="/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Папка для сохранения" Style="{StaticResource SteamLabel}"/>
                        <TextBox x:Name="FolderBox" Style="{StaticResource SteamTextBox}"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowseBtn" Content="Обзор..."
                            Style="{StaticResource SteamButton}"
                            VerticalAlignment="Bottom" Margin="8,0,0,0"
                            Click="BrowseBtn_Click"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Качество:" Foreground="#C7D5E0" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="QualityBox" Width="110" SelectedIndex="3"
                              Style="{StaticResource SteamCombo}"
                              SelectionChanged="QualityBox_SelectionChanged">
                        <ComboBoxItem Content="144"/>
                        <ComboBoxItem Content="240"/>
                        <ComboBoxItem Content="360"/>
                        <ComboBoxItem Content="480"/>
                        <ComboBoxItem Content="720"/>
                        <ComboBoxItem Content="1080"/>
                        <ComboBoxItem Content="1440 (2K)"/>
                        <ComboBoxItem Content="2160 (4K)"/>
                        <ComboBoxItem Content="4320 (8K)"/>
                    </ComboBox>

                    <TextBlock x:Name="FpsLabel" Text="FPS:" Foreground="#C7D5E0"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox x:Name="FpsBox" Width="90" SelectedIndex="0"
                              Style="{StaticResource SteamCombo}"
                              ToolTip="Ограничить частоту кадров. «Любой» — без ограничений.">
                        <ComboBoxItem Content="Любой"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="60"/>
                        <ComboBoxItem Content="120"/>
                    </ComboBox>

                    <Button x:Name="DownloadBtn" Content="Скачать"
                            Style="{StaticResource SteamButton}"
                            Margin="18,0,0,0" Click="DownloadBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="Отмена"
                            Style="{StaticResource SteamButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="CancelBtn_Click"/>
                    <Button x:Name="HistoryBtn" Content="История"
                            Style="{StaticResource SteamButton}"
                            Margin="8,0,0,0"
                            ToolTip="История загрузок"
                            Click="HistoryBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <StackPanel x:Name="PlaylistPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <CheckBox x:Name="PlaylistCheck"
                                  Foreground="#C7D5E0"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="Скачать плейлист"/>

                        <TextBlock Text="Первые:" Foreground="#8F98A0" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>

                        <TextBox x:Name="PlaylistLimitBox"
                                 Width="60" Height="24"
                                 Background="#16202D" Foreground="#C7D5E0"
                                 BorderBrush="#2A475E" BorderThickness="1"
                                 Padding="6,2" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTipService.InitialShowDelay="200"
                                 ToolTipService.ShowDuration="10000"
                                 ToolTip="Ограничить количество видео из плейлиста. Пусто — скачать все."/>

                        <TextBlock Text="видео" Foreground="#8F98A0" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <TextBlock Text="ⓘ" Foreground="#66C0F4" FontSize="14"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Cursor="Hand"
                                   ToolTipService.InitialShowDelay="200"
                                   ToolTipService.ShowDuration="10000"
                                   ToolTip="Ограничить количество видео из плейлиста. Оставьте поле пустым, чтобы скачать весь плейлист."/>
                    </StackPanel>

                    <CheckBox x:Name="AudioOnlyCheck"
                              Foreground="#C7D5E0"
                              FontSize="12"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              Checked="AudioOnlyCheck_Changed"
                              Unchecked="AudioOnlyCheck_Changed"
                              Content="Только аудио (mp3)"/>
                </StackPanel>

                <TextBlock x:Name="CodecHint"
                           Grid.Row="4"
                           Foreground="#F0A030"
                           FontSize="11"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"
                           Text="⚠ 2K+ требует AV1 → установить в ⚙"/>

                <Grid Grid.Row="5" Margin="0,6,0,6">
                    <ProgressBar x:Name="Progress" Height="22"
                                 Background="#16202D" Foreground="#66C0F4"
                                 BorderBrush="#2A475E" BorderThickness="1"
                                 Minimum="0" Maximum="100" Value="0"/>
                </Grid>

                <Grid Grid.Row="6" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#8F98A0"
                               FontSize="12" Text="Готов к работе"/>
                    <TextBlock x:Name="SpeedText" Grid.Column="1" Foreground="#8F98A0"
                               FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock x:Name="EtaText" Grid.Column="2" Foreground="#8F98A0"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="7"/>

                <Border Grid.Row="9"
                        Background="#0E1621"
                        BorderBrush="#2A475E"
                        BorderThickness="1"
                        CornerRadius="3"
                        Margin="0,0,0,0"
                        MinHeight="80"
                        HorizontalAlignment="Stretch">
                    <TextBox x:Name="LogBox"
                             Background="Transparent"
                             Foreground="#A9B7C6"
                             BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             Padding="8"/>
                </Border>

                <Grid Grid.Row="10" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="⚠ YouTube не качается?"
                                   Foreground="#8F98A0" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZapretHintLink"
                                   Text="подсказка"
                                   Foreground="#66C0F4"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   Cursor="Hand"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"
                                   MouseLeftButtonUp="ZapretHintLink_Click"/>
                    </StackPanel>
                    <Button x:Name="OpenFolderBtn" Content="📂 Открыть папку"
                            Style="{StaticResource SteamButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="14,6" FontSize="12"
                            Click="OpenFolderBtn_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>